# PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartexamprep

# JWT signing secret (replace with a strong random value)
JWT_SECRET=change-this-to-32-char-random-string

# Groq API configuration (single active AI provider)
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Comma-separated frontend origins allowed to call the backend
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to true behind HTTPS in production
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend to backend base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
